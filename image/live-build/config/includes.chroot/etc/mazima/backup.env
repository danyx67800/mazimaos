# Use a remote restic repository (sftp:, s3:, b2:, ...) for disaster recovery.
# A repository on the same disk only protects against accidental deletion.
RESTIC_REPOSITORY=/var/backups/mazima
RESTIC_PASSWORD_FILE=/etc/mazima/restic.password
MAZIMA_DATA_DIR=/var/lib/mazima
MAZIMA_APPS_DIR=/data/apps
# Set RESTIC_CHECK=1 to run a repository check after every backup.
RESTIC_CHECK=0
