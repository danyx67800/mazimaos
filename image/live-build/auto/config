#!/bin/sh
set -eu

lb config noauto \
  --architectures amd64 \
  --distribution trixie \
  --archive-areas "main contrib non-free non-free-firmware" \
  --binary-images iso-hybrid \
  --bootloaders "syslinux,grub-efi" \
  --bootappend-live "boot=live components quiet console=tty0" \
  --linux-flavours amd64 \
  --memtest none \
  --apt-recommends false \
  --compression xz \
  --image-name mazimaos \
  --iso-application "MazimaOS" \
  --iso-publisher "MazimaOS" \
  --iso-volume "MAZIMAOS" \
  --checksums sha256
